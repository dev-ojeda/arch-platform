# .npmrc (root)
# =============================================================================
# .npmrc - Configuración avanzada para PNPM Monorepo
# =============================================================================
#
# Archivo utilizado por pnpm para controlar:
# - performance
# - workspaces
# - resolución de dependencias
# - almacenamiento
# - linking
# - lockfiles
# - comportamiento CI/CD
#
# Compatible principalmente con:
# - pnpm
# - parcialmente npm
#
# =============================================================================


# =============================================================================
# PERFORMANCE
# =============================================================================

# Cantidad de reintentos automáticos al descargar paquetes.
# Útil en redes inestables o pipelines CI/CD.
#
# Default:
# fetch-retries=2
#
# Recomendado:
# 3-5 para CI/CD corporativo
#
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
# Tiempo máximo de espera para una descarga HTTP (milisegundos).
#
# 120000 = 120 segundos
#
# Evita fallos por conexiones lentas o registries privados.
#

fetch-timeout=300000


# Timeout general para operaciones de red.
#
# Incluye:
# - metadata
# - registry requests
# - package manifests
#
network-timeout=300000


# Prioriza paquetes existentes en cache local antes de consultar
# el registry remoto.
#
# Beneficios:
# - instalaciones más rápidas
# - menos tráfico de red
# - mejor experiencia offline
#
# Muy útil para:
# - monorepos
# - CI con cache
# - desarrollo local
#
prefer-offline=true


# Cantidad máxima de procesos concurrentes usados por pnpm
# para:
# - compilación
# - instalación
# - lifecycle scripts
#
# Ajustar según CPU/RAM disponibles.
#
# Recomendación:
# CPUs físicas x2 aprox
#
# Valores altos pueden saturar:
# - RAM
# - disco
# - antivirus Windows
#
child-concurrency=2


# =============================================================================
# WORKSPACE
# =============================================================================

# Determina si todo el monorepo comparte un único lockfile.
#
# true  -> pnpm-lock.yaml único en root
# false -> lockfiles separados
#
# En monorepos grandes:
# true suele ser recomendado
#
# false puede usarse para:
# - independencia parcial
# - builds aislados
# - plugins desacoplados
#
shared-workspace-lockfile=true


# Prioriza paquetes internos del workspace antes que versiones
# publicadas en npm registry.
#
# Ejemplo:
# @arch/core -> usa paquete local
#
# Fundamental para:
# - monorepos
# - desarrollo integrado
#
prefer-workspace-packages=true


# Guarda dependencias internas usando protocolo workspace.
#
# Ejemplo:
#
# "dependencies": {
#   "@arch/core": "workspace:*"
# }
#
# Beneficios:
# - evita instalaciones accidentales desde npm
# - asegura linking local
# - mejora consistencia
#
save-workspace-protocol=true


# Permite crear enlaces simbólicos automáticos entre paquetes
# del workspace.
#
# Ejemplo:
# packages/core -> linked into node_modules
#
# Fundamental para:
# - desarrollo local
# - hot reload
# - integración entre paquetes
#
link-workspace-packages=true


# =============================================================================
# NODE LINKER
# =============================================================================

# Estrategia usada para construir node_modules.
#
# Opciones:
# - isolated
# - hoisted
# - pnp
#
# isolated:
# - máxima aislación
# - evita dependency leaks
# - más determinístico
# - recomendado para monorepos modernos
#
node-linker=isolated


# Método usado para importar paquetes desde el store global.
#
# Opciones:
# - clone
# - hardlink
# - copy
#
# clone:
# - más seguro en Windows
# - evita corrupción accidental
# - mejor compatibilidad antivirus
#
# hardlink suele ser más rápido pero más sensible.
#
package-import-method=hardlink


# =============================================================================
# PEERS
# =============================================================================

# Instala automáticamente peerDependencies faltantes.
#
# Reduce errores manuales.
#
# Muy útil para:
# - React
# - ESLint
# - plugins
#
auto-install-peers=true


# Controla si pnpm falla cuando existen conflictos
# de peerDependencies.
#
# true  -> instalación falla
# false -> warnings solamente
#
# false mejora DX en ecosistemas complejos.
#
strict-peer-dependencies=false


# =============================================================================
# STORE
# =============================================================================

# Deshabilita el store server daemon.
#
# Evita problemas en:
# - Windows
# - WSL
# - Docker
# - antivirus corporativos
#
# Recomendado en entornos enterprise.
#
use-running-store-server=false


# Ubicación física del store global de pnpm.
#
# Todos los paquetes descargados se almacenan aquí.
#
# Beneficios:
# - cache compartido
# - ahorro de disco
# - instalaciones rápidas
#
# Recomendado:
# usar SSD rápido
#
store-dir=E:/.pnpm-store


# Habilita cache de paquetes compilados.
#
# Muy útil para paquetes nativos:
# - esbuild
# - sharp
# - node-gyp
#
side-effects-cache=false


# Permite escribir nuevos artifacts en cache.
#
# false:
# - cache lectura/escritura
#
# true:
# - solo lectura
#
side-effects-cache-readonly=false


# Verifica integridad criptográfica del store.
#
# Detecta:
# - corrupción
# - modificaciones
# - inconsistencias
#
verify-store-integrity=true


# Validación estricta de contenido de paquetes.
#
# Mejora:
# - seguridad
# - reproducibilidad
#
# Recomendado en:
# - CI/CD
# - enterprise
#
strict-store-pkg-content-check=true


# =============================================================================
# RESOLUTION
# =============================================================================

# Estrategia de resolución de versiones.
#
# Opciones:
# - highest
# - lowest-direct
# - time-based
#
# lowest-direct:
# usa la mínima versión compatible declarada.
#
# Beneficios:
# - mayor compatibilidad
# - detecta dependencias mal definidas
# - builds reproducibles
#
# resolution-mode=lowest-direct


# Deduplica dependencias peer compatibles.
#
# Reduce:
# - tamaño node_modules
# - duplicados
# - inconsistencias
#
dedupe-peer-dependents=true


# =============================================================================
# MONOREPO DX
# =============================================================================

# Evita que pnpm modifique automáticamente la versión
# definida en:
#
# packageManager
#
# dentro de package.json
#
# Útil para:
# - control manual
# - reproducibilidad CI
#
manage-package-manager-versions=false


# =============================================================================
# LOCKFILE
# =============================================================================

# Habilita uso de pnpm-lock.yaml
#
# Fundamental para:
# - reproducibilidad
# - CI/CD
# - seguridad
#
use-lockfile=true


# Prefiere usar lockfile exacto sin recalcular dependencias.
#
# Similar a:
# pnpm install --frozen-lockfile
#
# Beneficios:
# - builds determinísticos
# - CI más rápido
#
prefer-frozen-lockfile=false


# =============================================================================
# LOGGING
# =============================================================================

# Tipo de salida de logs.
#
# append-only:
# - ideal para CI/CD
# - evita output dinámico
# - logs más legibles
#
# Opciones:
# - default
# - append-only
# - ndjson
# - silent
#
reporter=append-only


# =============================================================================
# OPTIONAL
# =============================================================================

# Emula shell POSIX en Windows para scripts npm/pnpm.
#
# Mejora compatibilidad:
# - bash scripts
# - unix commands
# - cross-platform tooling
#
# shell-emulator=true


# Directorio donde pnpm crea estructura virtual de paquetes.
#
# Default:
# node_modules/.pnpm
#
# Beneficios de customizar:
# - rutas más cortas
# - menos problemas Windows MAX_PATH
#
virtual-store-dir=node_modules/.pnpm


# Tiempo máximo (minutos) antes de limpiar cache de módulos.
#
# 10080 = 7 días
#
modules-cache-max-age=10080


# Tiempo máximo cache para pnpm dlx.
#
# Mejora performance de:
# pnpm dlx <tool>
#
dlx-cache-max-age=10080


# Evita instalación recursiva automática en workspaces.
#
# true:
# instala todos los paquetes
#
# false:
# instala solo paquete actual
#
# Muy útil para:
# - monorepos enormes
# - builds parciales
#
recursive-install=true
# Prefiere crear ejecutables usando symlinks.
#
# Beneficios:
# - menos espacio
# - mejor performance
# - comportamiento más unix-like
#
prefer-symlinked-executables=false