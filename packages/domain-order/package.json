{
  "name": "@arch/domain-order",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "description": "Order domain package for the Arch Platform.",
  "keywords": [
    "arch",
    "domain",
    "orders",
    "platform"
  ],
  "arch": {
    "build": {
      "builder": "tsc-declaration",
      "outputs": [
        "dist"
      ]
    },
    "kind": "domain"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/public/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm build:dts",
    "build:dts": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/domain-order",
    "clean": "arch clean",
    "compliance": "arch compliance --package @arch/domain-order",
    "typecheck": "arch typecheck",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  }
}
