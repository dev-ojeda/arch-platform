{
  "name": "@arch/domain-order",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Order domain package for the Arch Platform.",
  "keywords": [
    "arch",
    "domain",
    "orders",
    "platform"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsx ../tooling/src/bin/build.ts",
    "clean": "tsx ../tooling/src/bin/clean.ts",
    "lint": "tsx ../tooling/src/bin/lint.ts",
    "typecheck": "tsx ../tooling/src/bin/typecheck.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@arch/tooling": "workspace:*"
  }
}
