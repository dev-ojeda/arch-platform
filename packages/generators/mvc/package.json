{
  "name": "@arch/generator-mvc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "arch": {
    "builder": "tsc"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "node ../../cli/dist/bin.js lint",
    "arch:build": "arch build --package @arch/generator-mvc",
    "arch:clean": "arch clean",
    "arch:lint": "arch lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*"
  }
}
