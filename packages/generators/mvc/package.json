{
  "name": "@arch/generator-mvc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "arch": {
    "build": {
      "builder": "tsc",
      "outputs": [
        "dist"
      ],
      "validateExports": true
    },
    "kind": "tooling"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/generator-mvc",
    "clean": "arch clean",
    "compliance": "arch compliance --package @arch/generator-mvc",
    "typecheck": "arch typecheck"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*"
  }
}
