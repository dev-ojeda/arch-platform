{
  "name": "@arch/generator-mvc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:dts",
    "build:js": "tsup",
    "build:dts": "tsc -p tsconfig.build.json",
    "clean": "tsx ../../tooling/src/bin/clean.ts",
    "lint": "tsx ../../tooling/src/bin/lint.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/tooling": "workspace:*"
  },
  "devDependencies": {
    "@arch/tooling": "workspace:*"
  }
}
