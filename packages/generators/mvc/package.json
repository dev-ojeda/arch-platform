{
  "name": "@arch/generator-mvc",
  "version": "0.1.0",
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:js",
    "build:js": "tsx ../../tooling/src/commands/build.ts",
    "clean": "tsx ../../tooling/src/commands/clean.js",
    "dev": "tsx ../../tooling/src/commands/dev.js",
    "lint": "tsx ../../tooling/src/commands/lint.ts",
    "typecheck": "tsx ../../tooling/src/commands/typecheck.js"
  },
  "sideEffects": false,
  "type": "module"
}
