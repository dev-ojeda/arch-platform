{
  "name": "@arch/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "import": "./dist/generation.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime.js"
    },
    "./use-cases/generate-project": {
      "types": "./dist/use-cases/generate-project/index.d.ts",
      "import": "./dist/use-cases.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsx ../tooling/src/bin/build.ts",
    "clean": "tsx ../tooling/src/bin/clean.ts",
    "lint": "tsx ../tooling/src/bin/lint.ts",
    "typecheck": "tsx ../tooling/src/bin/typecheck.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/core": "workspace:*",
    "@arch/generator-mvc": "workspace:*",
    "@arch/testing": "workspace:*",
    "handlebars": "^4.7.9"
  }
}
