{
  "name": "@arch/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "arch": {
    "artifactType": "runtime",
    "build": {
      "builder": "tsc",
      "outputs": [
        "dist"
      ],
      "validateExports": true
    },
    "kind": "app"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/application",
    "clean": "arch clean",
    "compliance": "arch compliance --package @arch/application",
    "typecheck": "arch typecheck",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/core": "workspace:*",
    "@arch/generator-mvc": "workspace:*",
    "@arch/testing": "workspace:*"
  },
  "devDependencies": {
    "handlebars": "^4.7.9"
  }
}
