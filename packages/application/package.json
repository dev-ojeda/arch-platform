{
  "name": "@arch/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist",

    "build": "tsup",

    "dev": "tsup --watch",

    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/core": "workspace:*",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@arch/testing": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
