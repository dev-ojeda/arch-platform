{
  // packages\application\tsconfig.json
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.js",
    "**/*.d.ts",
    "**/*.d.ts.map"
  ],
  "references": [
    {
      "path": "../contracts"
    },
    {
      "path": "../core"
    },
    {
      "path": "../testing"
    }
  ]
}