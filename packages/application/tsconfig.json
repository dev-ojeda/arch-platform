{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "./.turbo/application.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/*.js",
    "**/*.d.ts",
    "**/*.d.ts.map"
  ],
  "references": [
    {
      "path": "../contracts"
    },
    {
      "path": "../core"
    },
    {
      "path": "../generators/mvc"
    },
    {
      "path": "../testing"
    }
  ]
}