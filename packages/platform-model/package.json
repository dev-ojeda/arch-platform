{
  "name": "@arch/platform-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "pnpm clean && pnpm build:js && pnpm build:types",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  }
}
