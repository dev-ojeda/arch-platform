{
  "name": "@arch-platform/platform-model",
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "arch": {
    "artifactType": "declaration",
    "build": {
      "builder": "tsc-declaration",
      "tsconfig": "tsconfig.build.json",
      "outputs": [
        "dist"
      ]
    },
    "kind": "tooling"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch-platform/platform-model",
    "compliance": "arch compliance --package @arch-platform/platform-model --env dev",
    "clean": "arch clean --package @arch-platform/platform-model",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored --cache --cache-strategy content"
  }
}
