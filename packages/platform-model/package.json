{
  "name": "@arch/platform-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "arch": {
    "builder": "tsc-declaration"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm build:dts",
    "build:dts": "tsc -p tsconfig.build.json",
    "lint": "node ../cli/dist/bin.js lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "arch:clean": "arch clean",
    "arch:lint": "arch lint"
  }
}
