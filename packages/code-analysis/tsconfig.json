{
  "extends": "../../config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "./.turbo/code-analysis.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/public/analyze-code.disabled",
    "src/public/exported-symbols.disabled"
  ],
  "exclude": ["dist", "node_modules"]
}
