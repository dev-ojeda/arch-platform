{
  "name": "@arch/code-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.js"
    }
  },
  "arch": {
    "build": {
      "builder": "tsc",
      "outputs": [
        "dist"
      ],
      "validateExports": true
    },
    "kind": "tooling"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm build:dts",
    "build:dts": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/code-analysis",
    "clean": "arch clean",
    "compliance": "arch compliance --package @arch/code-analysis",
    "typecheck": "arch typecheck",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  },
  "dependencies": {
    "ts-morph": "catalog:",
    "typescript": "catalog:"
  }
}
