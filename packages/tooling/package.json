{
  "name": "@arch/tooling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands/build": {
      "types": "./dist/commands/build.d.ts",
      "import": "./dist/commands/build.js"
    },
    "./commands/clean": {
      "types": "./dist/commands/clean.d.ts",
      "import": "./dist/commands/clean.js"
    },
    "./commands/dev": {
      "types": "./dist/commands/dev.d.ts",
      "import": "./dist/commands/dev.js"
    },
    "./commands/lint": {
      "types": "./dist/commands/lint.d.ts",
      "import": "./dist/commands/lint.js"
    },
    "./commands/typecheck": {
      "types": "./dist/commands/typecheck.d.ts",
      "import": "./dist/commands/typecheck.js"
    },
    "./runtime/execute-command": {
      "types": "./dist/runtime/execute-command.d.ts",
      "import": "./dist/runtime/execute-command.js"
    }
  },
  "dependencies": {
    "execa": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsx ../tooling/src/bin/build.ts",
    "clean": "tsx ../tooling/src/bin/clean.ts",
    "lint": "tsx ../tooling/src/bin/lint.ts",
    "typecheck": "tsx ../tooling/src/bin/typecheck.ts",
    "dev": "tsx ../tooling/src/bin/dev.ts"
