{
  "name": "@arch/tooling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "node ../cli/dist/bin.js lint",
    "arch:clean": "node ../cli/dist/bin.js clean",
    "arch:lint": "node ../cli/dist/bin.js lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch/build-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "execa": "catalog:"
  }
}
