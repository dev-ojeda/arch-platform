{
  "name": "@arch-platform/tooling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "arch": {
    "artifactType": "runtime",
    "build": {
      "builder": "tsc",
      "outputs": [
        "dist"
      ],
      "validateExports": true
    },
    "kind": "tooling"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "arch": "arch build --package @arch-platform/tooling",
    "clean": "arch clean",
    "compliance": "arch compliance --package @arch-platform/tooling --env dev",
    "typecheck": "arch typecheck",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  },
  "dependencies": {
    "@arch-platform/build-core": "workspace:*",
    "@arch-platform/infrastructure": "workspace:*",
    "execa": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
