{
  "name": "@arch/tooling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "mode": "tsc",
    "build": "tsx ../tooling/src/bin/build.ts --package @arch/tooling",
    "build:dts": "tsc -p tsconfig.build.json",
    "clean": "tsx ../tooling/src/bin/clean.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch/build-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "execa": "catalog:"
  }
}
