{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": false, // Asegura que emita tanto .js como .d.ts
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true, // Mapeo para el código JavaScript ejecutable
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo" // Archivo de caché único para este paquete
  }
}
