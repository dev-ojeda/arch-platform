{
  "name": "@arch/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "mode": "tsc",
    "build": "tsx ../tooling/src/bin/build.ts --package @arch/core",
    "build:dts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "tsx ../tooling/src/bin/clean.ts",
    "lint": "tsx ../tooling/src/bin/lint.ts",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*"
  },
  "devDependencies": {
    "@arch/tooling": "workspace:*"
  }
}
