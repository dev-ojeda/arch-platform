{
    "extends": "../../config/tsconfig/library.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "composite": true,
        "declaration": true,
        "emitDeclarationOnly": false,
        "tsBuildInfoFile": "./dist/.tsbuildinfo"
    },
    "include": [
        "src"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "**/*.test.ts",
        "**/__tests__/**"
    ],
    "references": [
        {
            "path": "../contracts"
        },
        {
            "path": "../language-registry"
        }
    ]
}