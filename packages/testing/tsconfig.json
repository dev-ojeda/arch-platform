{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.js",
    "**/*.d.ts",
    "**/*.d.ts.map"
  ],
  "references": [
    {
      "path": "../contracts"
    },
    {
      "path": "../core"
    }
  ]
}