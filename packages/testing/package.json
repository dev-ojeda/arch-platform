{
  "name": "@arch-platform/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "arch": {
    "artifactType": "runtime",
    "build": {
      "builder": "tsc",
      "outputs": [
        "dist"
      ],
      "validateExports": true
    },
    "kind": "tooling"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch-platform/testing",
    "clean": "arch clean --package @arch-platform/testing",
    "compliance": "arch compliance --package @arch-platform/testing --env dev",
    "typecheck": "arch typecheck --package @arch-platform/testing"
  },
  "dependencies": {
    "@arch-platform/contracts": "0.3.0-0",
    "@arch-platform/core": "workspace:*",
    "@arch-platform/platform-model": "workspace:*"
  }
}
