{
  "name": "@arch/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/core": "workspace:*",
    "@arch/infrastructure": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.6"
  }
}