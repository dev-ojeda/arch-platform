{
  "name": "@arch/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "arch": {
    "build": {
      "builder": "tsc",
      "entry": "./src/index.ts",
      "validateExports": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/testing",
    "clean": "arch clean",
    "typecheck": "arch typecheck",
    "lint": "arch lint",
    "validate": "arch validate"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/platform-model": "workspace:*",
    "@arch/core": "workspace:*"
  }
}
