{
  "name": "@arch/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "arch": {
    "builder": "tsc"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "node ../cli/dist/bin.js lint",
    "arch:build": "arch build --package @arch/testing",
    "arch:clean": "arch clean",
    "arch:lint": "arch lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/core": "workspace:*"
  }
}
