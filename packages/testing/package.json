{
  "name": "@arch/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "arch": {
    "build": {
      "builder": "tsc-declaration"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/testing",
    "clean": "arch clean",
    "typecheck": "arch typecheck",
    "lint": "arch lint"
  },
  "dependencies": {
    "@arch/contracts": "workspace:*",
    "@arch/core": "workspace:*"
  }
}
