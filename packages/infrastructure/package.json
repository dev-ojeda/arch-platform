{
  "name": "@arch/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "arch": {
    "build": {
      "builder": "tsc",
      "entry": "./src/index.ts",
      "validateExports": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/infrastructure",
    "clean": "arch clean",
    "typecheck": "arch typecheck",
    "lint": "arch lint",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  },
  "dependencies": {
    "@arch/platform-model": "workspace:*",
    "@arch/contracts": "workspace:*",
    "@arch/testing": "workspace:*"
  },
  "devDependencies": {
    "handlebars": "^4.7.9"
  }
}
