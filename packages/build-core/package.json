{
  "name": "@arch/build-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "arch": {
    "build": {
      "builder": "tsc",
      "outputs": [
        "dist"
      ],
      "validateExports": true
    }
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "arch": "arch build --package @arch/build-core",
    "clean": "arch clean",
    "lint": "arch lint",
    "typecheck": "arch typecheck",
    "validate": "arch validate --package @arch/build-core",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  },
  "dependencies": {
    "@arch/platform-model": "workspace:*",
    "@arch/contracts": "workspace:*",
    "@arch/infrastructure": "workspace:*"
  }
}
