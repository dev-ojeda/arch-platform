{
  "name": "@arch-platform/build-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "arch": {
    "artifactType": "runtime",
    "build": {
      "builder": "tsc",
      "outputs": [
        "dist"
      ],
      "validateExports": true
    },
    "kind": "tooling"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch-platform/build-core",
    "clean": "arch clean --package @arch-platform/build-core",
    "compliance": "arch compliance --package @arch-platform/build-core --env dev",
    "typecheck": "arch typecheck --package @arch-platform/build-core",
    "test": "vitest run -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "test:watch": "vitest",
    "test:clear": "vitest --clearCache"
  },
  "dependencies": {
    "@arch-platform/contracts": "0.3.0-0",
    "@arch-platform/infrastructure": "workspace:*",
    "@arch-platform/platform-model": "workspace:*"
  }
}
