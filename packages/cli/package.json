{
  "name": "@arch/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "arch": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@arch/governance": "workspace:*"
  },
  "devDependencies": {
    "@arch/tooling": "workspace:*"
  },
  "scripts": {
    "build": "tsx ../tooling/src/bin/build.ts",
    "clean": "tsx ../tooling/src/bin/clean.ts",
    "lint": "tsx ../tooling/src/bin/lint.ts",
    "typecheck": "tsx ../tooling/src/bin/typecheck.ts"
  }
}
