{
  "name": "@arch/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin"
  ],
  "arch": {
    "build": {
      "builder": "tsup",
      "outputs": [
        "dist"
      ]
    }
  },
  "bin": {
    "arch": "./bin/arch.js"
  },
  "scripts": {
    "arch": "arch build --package @arch/cli",
    "build": "tsup",
    "clean": "arch clean",
    "lint": "arch lint",
    "typecheck": "arch typecheck",
    "validate": "arch validate --package @arch/cli"
  },
  "dependencies": {
    "@arch/governance": "workspace:*",
    "@arch/tooling": "workspace:*",
    "@arch/infrastructure": "workspace:*",
    "cac": "catalog:"
  }
}
