{
  "name": "@arch/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "arch": "./bin/arch.js"
  },
  "scripts": {
    "arch": "node ./dist/bin.js",
    "build": "tsup",
    "arch:build": "arch build --package @arch/cli",
    "lint": "node ./dist/bin.js lint",
    "arch:clean": "arch clean",
    "arch:lint": "arch lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch/governance": "workspace:*",
    "@arch/tooling": "workspace:*",
    "cac": "catalog:"
  }
}
