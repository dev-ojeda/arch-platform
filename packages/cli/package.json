{
  "name": "@arch/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "arch": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "arch": "node ./dist/index.js",
    "build:dts": "tsc -p tsconfig.build.json",
    "build": "pnpm build:dts",
    "clean": "tsx ../tooling/src/bin/clean.ts",
    "lint": "tsx ../tooling/src/bin/lint.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch/governance": "workspace:*"
  },
  "devDependencies": {
    "cac": "catalog:",
    "@arch/tooling": "workspace:*"
  }
}
