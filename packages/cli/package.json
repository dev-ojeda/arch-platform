{
  "name": "@arch-platform/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin"
  ],
  "arch": {
    "artifactType": "runtime",
    "build": {
      "builder": "tsup",
      "tsconfig": "tsconfig.json",
      "outputs": [
        "dist"
      ]
    },
    "kind": "app"
  },
  "bin": {
    "arch": "./bin/arch.js"
  },
  "scripts": {
    "arch": "arch build --package @arch-platform/cli",
    "build": "tsup",
    "clean": "arch clean --package @arch-platform/cli",
    "compliance": "arch compliance --package @arch-platform/cli --env dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored --cache --cache-strategy content"
  },
  "dependencies": {
    "@arch-platform/application": "workspace:*",
    "@arch-platform/governance": "workspace:*",
    "@arch-platform/tooling": "workspace:*",
    "@arch-platform/compliance": "workspace:*",
    "cac": "catalog:"
  }
}
