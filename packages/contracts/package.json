{
  "name": "@arch/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "arch": {
    "builder": "tsc-declaration"
  },
  "scripts": {
    "build": "pnpm build:dts",
    "build:dts": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch/contracts",
    "clean": "arch clean",
    "typecheck": "arch typecheck",
    "lint": "arch lint"
  }
}
