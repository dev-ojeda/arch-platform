{
  "name": "@arch-platform/contracts",
  "version": "0.3.0-0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "arch": {
    "artifactType": "declaration",
    "build": {
      "builder": "tsc-declaration",
      "mode": "external",
      "tsconfig": "tsconfig.build.json",
      "outputs": [
        "dist"
      ]
    },
    "kind": "tooling"
  },
  "scripts": {
    "build": "pnpm build:dts",
    "build:dts": "tsc -p tsconfig.build.json",
    "arch": "arch build --package @arch-platform/contracts",
    "clean": "arch clean --package @arch-platform/contracts",
    "compliance": "arch compliance --package @arch-platform/contracts --env dev",
    "typecheck": "arch typecheck --package @arch-platform/contracts"
  },
  "license": "MIT"
}
