{
  "name": "@arch/contracts",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
