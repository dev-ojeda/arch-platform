{
  // packages\contracts\tsconfig.build.json
  "extends": "../../tsconfig.base.json", // (root)
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
