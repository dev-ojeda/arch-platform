{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cleanup:fast",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cleanup-fast.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "cleanup:full",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        
        "${workspaceFolder}/scripts/cleanup-full.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "install",
      "type": "shell",
      "command": "pnpm install",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "deps:validate",
      "type": "shell",
      "command": "pnpm cruiser",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "pnpm test",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "workspace:reset",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "cleanup:fast",
        "install",
        "build"
      ],
      "problemMatcher": [],
      "command": "echo workspace reset completed"
    },
    {
      "label": "workspace:validate",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "typecheck",
        "deps:validate",
        "test",
        "build"
      ],
      "problemMatcher": [],
      "command": "echo workspace validation completed"
    }
  ]
}