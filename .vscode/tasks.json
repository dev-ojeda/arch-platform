{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "FORCE_COLOR": "1"
    }
  },
  "inputs": [
    {
      "id": "cleanupDryRun",
      "type": "pickString",
      "description": "Enable DryRun mode?",
      "options": ["", "-DryRun"],
      "default": ""
    },
    {
      "id": "cleanupSkipStore",
      "type": "pickString",
      "description": "Skip PNPM store cleanup?",
      "options": ["", "-SkipPnpmStore"],
      "default": ""
    },
    {
      "id": "cleanupVerbose",
      "type": "pickString",
      "description": "Enable verbose output?",
      "options": ["", "-VerboseOutput"],
      "default": ""
    },
    {
      "id": "turboFilter",
      "type": "promptString",
      "description": "Turbo filter (optional)",
      "default": ""
    },
    {
      "id": "package",
      "type": "promptString",
      "description": "Nombre del package"
    }
  ],
  "tasks": [
    {
      "label": "cleanup:full",
      "detail": "Perform full workspace cleanup",
      "icon": {
        "id": "trash",
        "color": "terminal.ansiRed"
      },
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/cleanup-full.ps1",
        "${input:cleanupDryRun}",
        "${input:cleanupSkipStore}",
        "${input:cleanupVerbose}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "cleanup:turbo-cache",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "if (Test-Path .turbo) { Remove-Item .turbo -Recurse -Force }"
      ],
      "problemMatcher": []
    },
    {
      "label": "workspace:cleanup:dist",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./scripts/cleanup/cleanup-dist.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "validate:lint",
      "type": "shell",
      "command": "pnpm",
      "args": ["lint"],
      "group": "test",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "validate:typecheck",
      "type": "shell",
      "command": "pnpm",
      "args": ["typecheck"],
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "validate:test",
      "type": "shell",
      "command": "pnpm",
      "args": ["test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "workspace:install",
      "detail": "Install workspace dependencies",
      "icon": {
        "id": "package",
        "color": "terminal.ansiGreen"
      },
      "type": "shell",
      "command": "pnpm",
      "args": ["install", "--prefer-offline"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "workspace:update",
      "type": "shell",
      "command": "pnpm",
      "args": ["update", "-r"],
      "problemMatcher": []
    },
    {
      "label": "platform:build",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "platform:dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "package:build",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "${input:package}", "build"]
    },
    {
      "label": "package:model:build",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@arch/platform-model", "build"],
      "problemMatcher": ["$tsc"]
    }
  ]
}
