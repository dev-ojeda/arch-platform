{
  // -----------------------------------------------------------------------------
  // EDITOR
  // -----------------------------------------------------------------------------
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "top",
  "editor.inlineSuggest.enabled": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  // -----------------------------------------------------------------------------
  // WORKBENCH
  // -----------------------------------------------------------------------------
  "workbench.startupEditor": "readme",
  "window.commandCenter": true,
  "debug.inlineValues": "on",
  // -----------------------------------------------------------------------------
  // EXPLORER
  // -----------------------------------------------------------------------------
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  // -----------------------------------------------------------------------------
  // FILES
  // -----------------------------------------------------------------------------
  "files.insertFinalNewline": false,
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/.turbo": true,
    "**/.pnpm-store": true,
    "**/coverage": false
  },
  "files.watcherExclude": {
    "**/.pnpm-store/**": true,
    "**/.turbo/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true
  },
  "files.associations": {
    "*.ts": "typescript",
    "*.js": "javascript",
    "*.yml": "yaml",
    "*.bat": "bat",
    "*.scpt": "shellscript",
    ".npmrc": "ini",
    ".json": "json"
  },
  // -----------------------------------------------------------------------------
  // SEARCH
  // -----------------------------------------------------------------------------
  "search.followSymlinks": false,
  "search.sortOrder": "type",
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/coverage": true,
    "**/dist": true
  },
  // -----------------------------------------------------------------------------
  // GIT
  // -----------------------------------------------------------------------------
  "git.autoStash": true,
  "git.confirmForcePush": false,
  "git.openRepositoryInParentFolders": "always",
  // -----------------------------------------------------------------------------
  // TASKS
  // -----------------------------------------------------------------------------
  "task.allowAutomaticTasks": "on",
  "task.quickOpen.history": 30,
  "task.quickOpen.skip": true,
  // -----------------------------------------------------------------------------
  // TESTING
  // -----------------------------------------------------------------------------
  "testing.automaticallyOpenPeekView": "never",
  // -----------------------------------------------------------------------------
  // TYPESCRIPT / JAVASCRIPT
  // -----------------------------------------------------------------------------
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.tsserver.log": "off",
  "typescript.tsserver.watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "fixedPollingInterval"
  },
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.format.insertSpaceBeforeFunctionParenthesis": true,
  // -----------------------------------------------------------------------------
  // TERMINAL / POWERSHELL
  // -----------------------------------------------------------------------------
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd",
      "overrideName": true
    },
    "Git Bash": {
      "source": "Git Bash"
    }
  },
  "powershell.cwd": "${workspaceFolder}",
  "powershell.powerShellAdditionalExePaths": {
    "pwsh": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
  },
  "powershell.integratedConsole.focusConsoleOnExecute": false,
  "powershell.promptToUpdatePowerShell": false,
  // -----------------------------------------------------------------------------
  // PACKAGE MANAGERS
  // -----------------------------------------------------------------------------
  "npm.autoDetect": "off",
  // -----------------------------------------------------------------------------
  // BETTER COMMENTS
  // -----------------------------------------------------------------------------
  "better-comments.multilineComments": true,
  "better-comments.highlightPlainText": false,
  "better-comments.tags": [
    {
      "tag": "!",
      "color": "#FF5555",
      "bold": true
    },
    {
      "tag": "?",
      "color": "#61AFEF",
      "bold": true
    },
    {
      "tag": "todo",
      "color": "#FFB86C",
      "bold": true
    },
    {
      "tag": "fix",
      "color": "#FF6B6B",
      "bold": true
    },
    {
      "tag": "hack",
      "color": "#E06C75",
      "bold": true,
      "italic": true
    },
    {
      "tag": "perf",
      "color": "#C678DD",
      "bold": true
    },
    {
      "tag": "deprecated",
      "color": "#7F848E",
      "italic": true,
      "strikethrough": true
    },
    {
      "tag": "*",
      "color": "#98C379"
    }
  ],
  // -----------------------------------------------------------------------------
  // TODO TREE
  // -----------------------------------------------------------------------------
  "todo-tree.general.tags": [
    "todo",
    "fix",
    "hack",
    "perf",
    "deprecated"
  ],
  // -----------------------------------------------------------------------------
  // AUTO PATH HEADER
  // -----------------------------------------------------------------------------
  "autoPathHeader.ignoredDirectories": [
    "temp",
    "**/node_modules",
    "dist/*"
  ],
  "autoPathHeader.allowedOnlyDirectories": [
    "src",
    "**/utils",
    "src/**/*.ts"
  ],
  // -----------------------------------------------------------------------------
  // FOLDER TEMPLATES
  // -----------------------------------------------------------------------------
  "folderTemplates.structures": [
    {
      "structure": [
        {
          "fileName": "index.ts",
          "template": "export * from './';"
        }
      ]
    }
  ],
  // -----------------------------------------------------------------------------
  // RUFF
  // -----------------------------------------------------------------------------
  "ruff.format.preview": true,
  // -----------------------------------------------------------------------------
  // LANGUAGE SPECIFIC
  // -----------------------------------------------------------------------------
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[bat]": {
    "files.eol": "\n",
    "editor.autoIndent": "full",
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingComments": "beforeWhitespace",
    "editor.autoClosingDelete": "always",
    "editor.autoClosingOvertype": "auto",
    "editor.formatOnType": true,
    "editor.tabCompletion": "onlySnippets",
    "editor.snippetSuggestions": "inline",
    "editor.suggest.insertMode": "replace",
    "diffEditor.ignoreTrimWhitespace": true,
    "editor.defaultFormatter": "toramameseven.bat-tools"
  },
  "terminal.integrated.tabs.defaultColor": "terminal.ansiGreen"
}