{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Architecture Generator",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
            ],
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/apps/vscode-extension/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "preLaunchTask": "build:vscode-extension",
            "sourceMaps": true,
            "smartStep": true,
            "internalConsoleOptions": "neverOpen"
        }
    ]
}