{
  // tsconfig.eslint.json
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "*.ts",
    "*.js"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**"
  ]
}