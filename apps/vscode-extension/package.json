{
    "name": "arch-generator",
    "displayName": "Architecture Generator",
    "description": "Extensible architecture scaffolding platform for VSCode",
    "version": "0.1.0",
    "private": true,
    "publisher": "dev-ojeda",
    "license": "MIT",
    "type": "commonjs",
    "sideEffects": false,
    "engines": {
        "node": ">=20",
        "vscode": "^1.90.0"
    },
    "main": "./dist/extension.js",
    "files": [
        "dist"
    ],
    "categories": [
        "Other",
        "Snippets"
    ],
    "keywords": [
        "architecture",
        "generator",
        "scaffolding",
        "typescript",
        "mvc",
        "clean-architecture",
        "codegen"
    ],
    "activationEvents": [
        "onCommand:arch.generateProject"
    ],
    "contributes": {
        "commands": [
            {
                "command": "arch.generateProject",
                "title": "ARCH: Generate Project"
            }
        ]
    },
    "scripts": {
        "clean": "rimraf dist .turbo",
        "clean:ts": "rimraf tsconfig.tsbuildinfo",
        "typecheck": "tsc --noEmit",
        "bundle": "node esbuild.cjs",
        "build": "pnpm clean && pnpm typecheck && pnpm bundle",
        "dev": "node esbuild.cjs --watch",
        "package": "vsce package"
    },
    "dependencies": {
        "@arch/application": "workspace:*",
        "@arch/contracts": "workspace:*",
        "@arch/core": "workspace:*",
        "@arch/generator-mvc": "workspace:*",
        "@arch/infrastructure": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/vscode": "^1.90.0",
        "@vscode/vsce": "^3.6.2",
        "esbuild": "^0.27.0"
    }
}