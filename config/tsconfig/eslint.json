{
  "extends": "./base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@arch-platform/*": ["../packages/*/src"],
      "@arch-platform/generator-mvc": ["../packages/generators/mvc/src"]
    }
  },
  "include": [
    "tsconfig.ts",
    "vitest.config.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "config/**/*.ts",
    "*.ts",
    "*.mts",
    "*.cts"
  ],
  "exclude": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/.changeset/**",
    "**/.cache/**",
    "**/generated/**",
    "apps/**"
  ]
}
