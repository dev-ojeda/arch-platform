{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "ignoreDeprecations": "6.0",
        "types": [
            "node"
        ],
        "baseUrl": ".",
        "paths": {
            "@arch/*": [
                "packages/*/src"
            ]
        }
    }
}