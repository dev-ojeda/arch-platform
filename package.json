{
  "name": "arch-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@arch-platform/cli": "workspace:*",
    "@arch-platform/contracts": "0.3.0-0",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/test-electron": "catalog:",
    "dependency-cruiser": "catalog:",
    "esbuild-visualizer": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-node": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@4.17.1",
    "eslint-plugin-import-x": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "syncpack": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "workspaces": [
    "packages/*",
    "packages/generators/*"
  ],
  "engines": {
    "node": "22.19.0",
    "pnpm": "10.33.3"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "arch": "pwsh ./tools/powershell/arch.ps1",
    "doctor": "arch doctor",
    "build": "turbo run build --output-logs=errors-only",
    "lint": "turbo run lint //#lint:scripts --concurrency=8 --output-logs=errors-only",
    "lint:fix": "turbo run lint //#lint:scripts --concurrency=8 -- --fix",
    "lint:scripts": "arch lint",
    "lint:all": "pwsh ./tools/powershell/arch.ps1 \"lint\"",
    "typecheck": "turbo run typecheck --output-logs=errors-only",
    "validate": "pnpm lint && pnpm markdown:lint && pnpm typecheck && pnpm test --output-logs=errors-only && pnpm arch validate",
    "bootstrap": "pnpm install && turbo run build",
    "rebuild": "pnpm clean && pnpm build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "validate:strict": "pnpm doctor && pnpm validate && pnpm cruiser",
    "check": "pnpm lint && pnpm cruiser",
    "ci": "pnpm validate && pnpm build",
    "graph": "turbo run build --graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "clean": "pnpm run clean:dist",
    "clean:dist": "pwsh -File ./scripts/cleanup/cleanup-workspace.ps1",
    "clean:all": "pwsh ./tools/powershell/cleanup.ps1",
    "clean:dry": "pwsh -File ./scripts/cleanup/cleanup-workspace.ps1 -DryRun -VerboseOutput",
    "reset": "pnpm run clean:all && pnpm install",
    "reinstall": "pnpm run clean:all && pnpm install --frozen-lockfile",
    "cruiser": "depcruise . --config .dependency-cruiser.cjs",
    "prepare": "husky",
    "check-auth": "npm whoami || (echo '❌ Sesión expirada. Por favor ejecuta: npm login' && exit 1)",
    "prepublishOnly": "npm run check-auth",
    "markdown:lint": "markdownlint-cli2 \"**/*.md\"",
    "cache:lock-rename": "tsx ./scripts/run-rename.ts",
    "lint:profile": "pwsh -Command \"$env:TIMING=1; pnpm exec eslint src --no-cache\""
  },
  "lint-staged": {
    "{packages,config}/**/*.{ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "{scripts,config}/**/*.{js,mjs,cjs}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
