{
  "name": "arch-platform",
  "version": "0.1.0",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/test-electron": "catalog:",
    "cac": "catalog:",
    "depcheck": "catalog:",
    "dependency-cruiser": "catalog:",
    "esbuild-visualizer": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-node": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "syncpack": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.33.3",
  "private": true,
  "scripts": {
    "doctor": "pnpm arch:doctor",
    "arch": "tsx packages/cli/src/index.ts",
    "arch:doctor": "tsx packages/cli/src/index.ts doctor",
    "bootstrap": "pnpm install && turbo run build",
    "reinstall": "pnpm clean:all && pnpm install",
    "build": "turbo run build",
    "rebuild": "pnpm clean && pnpm build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validate": "turbo run validate",
    "validate:strict": "pnpm doctor && pnpm validate && pnpm cruiser",
    "check": "pnpm doctor && pnpm lint && pnpm typecheck && pnpm test",
    "ci": "pnpm validate && pnpm build",
    "graph": "turbo run build --graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "clean": "turbo run clean",
    "clean:modules": "pwsh -File ./scripts/cleanup/cleanup-node-modules.ps1",
    "clean:dist": "pwsh -File ./scripts/cleanup/cleanup-dist.ps1",
    "clean:packages": "pwsh -File ./scripts/clean-packages.ps1",
    "clean:all": "pnpm reset -IncludeRootNodeModules",
    "reset": "pwsh -File ./scripts/reset/reset-workspace.ps1",
    "cruiser": "depcruise . --config .dependency-cruiser.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --cache"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
