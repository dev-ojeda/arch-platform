{
  "name": "arch-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@arch-platform/cli": "workspace:*",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/test-electron": "catalog:",
    "dependency-cruiser": "catalog:",
    "esbuild-visualizer": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-node": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@4.17.1",
    "eslint-plugin-import-x": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "syncpack": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "workspaces": [
    "packages/*",
    "packages/generators/*"
  ],
  "engines": {
    "node": "22.19.0",
    "pnpm": "10.33.3"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "arch": "node ./scripts/cli/run-arch.mjs",
    "doctor": "arch doctor",
    "build": "turbo run build --concurrency=3 --output-logs=errors-only",
    "lint": "turbo run lint //#lint:scripts --concurrency=2 --output-logs=errors-only",
    "lint:fix": "turbo run lint //#lint:scripts --concurrency=2 -- --fix",
    "lint:scripts": "arch lint",
    "lint:all": "node ./scripts/cli/run-arch.mjs lint",
    "typecheck": "turbo run typecheck --concurrency=2 --output-logs=errors-only",
    "validate": "turbo run lint //#lint:scripts typecheck test --concurrency=2 --output-logs=errors-only && pnpm markdown:lint && pnpm arch validate",
    "validate:full": "pnpm validate && pnpm test:integration",
    "bootstrap": "pnpm install && turbo run build --concurrency=2",
    "rebuild": "pnpm clean && pnpm build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test --concurrency=2 --output-logs=errors-only",
    "test:integration": "turbo run test:integration --concurrency=1 --output-logs=errors-only",
    "coverage": "turbo run coverage --concurrency=2",
    "validate:strict": "pnpm doctor && pnpm validate && pnpm cruiser",
    "check": "pnpm lint && pnpm cruiser",
    "ci": "pnpm validate && pnpm build",
    "graph": "turbo run build --graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "clean": "pnpm run clean:dist",
    "clean:dist": "node ./scripts/cleanup/cleanup-workspace.mjs",
    "clean:dry": "node ./scripts/cleanup/cleanup-workspace.mjs --dry-run --verbose",
    "clean:all": "node ./scripts/cleanup/cleanup-workspace.mjs --all",
    "reset": "pnpm run clean:all && pnpm install",
    "reinstall": "pnpm run clean:all && pnpm install --frozen-lockfile",
    "cruiser": "depcruise . --config .dependency-cruiser.cjs",
    "prepare": "husky",
    "check-auth": "node -e \"import('node:child_process').then(m => { try { m.execSync('npm whoami', { stdio: 'inherit' }); } catch { console.error('❌ Sesión expirada. Por favor ejecuta: npm login'); process.exit(1); } })\"",
    "prepublishOnly": "npm run check-auth",
    "markdown:lint": "markdownlint-cli2 \"**/*.md\"",
    "cache:lock-rename": "tsx ./scripts/run-rename.ts",
    "lint:profile": "node -e \"process.env.TIMING='1'; import('node:child_process').then(m => m.execSync('pnpm exec eslint src --no-cache', { stdio: 'inherit' }))\"",
    "search:source": "node ./scripts/search-source.mjs"
  },
  "lint-staged": {
    "{packages,config}/**/*.{ts,tsx}": [
      "node scripts/lint-staged/eslint-by-package.mjs",
      "prettier --write"
    ],
    "{scripts,config}/**/*.{js,mjs,cjs}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
