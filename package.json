{
  "name": "arch-platform",
  "version": "0.1.0",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/test-electron": "catalog:",
    "cac": "catalog:",
    "dependency-cruiser": "catalog:",
    "esbuild-visualizer": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-node": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "execa": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "syncpack": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.3",
  "private": true,
  "scripts": {
    "arch": "tsx packages/cli/src/index.ts",
    "arch:doctor": "tsx packages/cli/src/index.ts doctor",
    "build": "turbo run build",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "clean:artifacts": "rimraf packages/**/dist apps/**/dist",
    "clean:deep": "powershell -ExecutionPolicy Bypass -File scripts/clean-deep.ps1",
    "cruiser": "depcruise . --config .dependency-cruiser.cjs",
    "cruiser:strict": "depcruise . --config .dependency-cruiser.cjs --fail-on-severity warn",
    "cruiser:arch": "depcruise . --config .dependency-cruiser.cjs --output-type archi",
    "cruiser:err": "depcruise . --config .dependency-cruiser.cjs --output-type err",
    "cruiser:graph": "depcruise . --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
    "cruiser:html": "depcruise . --config .dependency-cruiser.cjs --output-type html > dependency-report.html",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:fix": "eslint packages apps --fix",
    "prepare": "husky || true",
    "prebuild": "pnpm arch doctor",
    "reset": "pwsh -File ./scripts/reset/reset-workspace.ps1",
    "syncpack:fix": "syncpack fix",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:core": "vitest run --project core --coverage",
    "test:coverage:runtime": "vitest run --project application --coverage",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate"
  }
}
