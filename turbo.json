{
  "$schema": "https://turbo.build/schema.json",

  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "config/tsconfig/base.json",
    "tsconfig.base.json",
    "vitest.shared.ts",
    "vitest.setup.ts",
    "tsup.base.ts"
  ],

  "globalEnv": ["NODE_ENV", "CI"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],

      "inputs": ["$TURBO_DEFAULT$", "src/**", "testing/**", "tsup.config.*"],

      "outputs": ["dist/**", "!dist/**/*.tsbuildinfo"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck", "@arch/tooling#build"],

      "inputs": ["$TURBO_DEFAULT$", "src/**", "testing/**"],

      "outputs": []
    },

    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "src/**", "testing/**"],

      "outputs": []
    },

    "test": {
      "dependsOn": ["^build", "build"],

      "inputs": ["$TURBO_DEFAULT$", "src/**", "testing/**", "**/*.test.ts", "**/*.snap"],

      "outputs": []
    },

    "coverage": {
      "dependsOn": ["test"],

      "outputs": ["coverage/**"]
    },

    "dev": {
      "cache": false,

      "persistent": true
    },

    "cruiser": {
      "inputs": ["$TURBO_DEFAULT$", "src/**", "testing/**", ".dependency-cruiser.*"],

      "outputs": []
    },

    "clean": {
      "cache": false,

      "outputs": []
    }
  }
}
