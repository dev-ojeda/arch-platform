{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "pnpm-lock.yaml",
        "config/tsconfig/base.json",
        "tsup.base.mts",
        ".env*"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "src/**",
                "package.json",
                "tsconfig.json",
                "tsup.config.*"
            ],
            "outputs": [
                "dist/**",
                "!dist/**/*.tsbuildinfo"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ],
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "cruiser": {
            "outputs": []
        },
        "clean": {
            "cache": false
        }
    }
}