{
  "$schema": "https://turbo.build/schema.json",

  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "tsup.base.ts",
    "vitest.shared.ts",
    "vitest.setup.ts"
  ],

  "globalEnv": ["NODE_ENV", "CI", "GITHUB_ACTIONS"],

  "tasks": {
    "doctor": {
      "cache": false,
      "outputs": []
    },

    "build": {
      "dependsOn": ["^build"],

      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "testing/**/*.ts",
        "tsup.config.*",
        "tsconfig*.json"
      ],

      "outputs": ["dist/**"]
    },

    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],

      "inputs": ["$TURBO_DEFAULT$", "src/**/*.ts", "testing/**/*.ts", "tsconfig*.json"],

      "outputs": []
    },

    "lint": {
      "dependsOn": ["^lint"],

      "inputs": ["$TURBO_DEFAULT$", "src/**/*.ts", "testing/**/*.ts", "eslint.config.*"],

      "outputs": []
    },

    "test": {
      "dependsOn": ["^build", "build"],

      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "testing/**/*.ts",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.snap"
      ],

      "outputs": ["coverage/**"]
    },

    "coverage": {
      "dependsOn": ["^build", "test"],

      "outputs": ["coverage/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "clean": {
      "cache": false,
      "outputs": []
    },

    "validate": {
      "dependsOn": ["lint", "typecheck", "test"],

      "outputs": []
    }
  }
}
