{
  "$schema": "https://turbo.build/schema.json",

  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",

    "tsconfig.base.json",

    "tsup.base.ts",

    "vitest.shared.ts",
    "vitest.workspace.ts",
    "vitest.setup.ts",

    "eslint.config.mjs"
  ],

  "globalEnv": ["NODE_ENV", "CI", "GITHUB_ACTIONS"],

  "tasks": {
    "doctor": {
      "cache": false,
      "outputs": []
    },

    "clean": {
      "cache": false,
      "outputs": []
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],

      "inputs": [
        "$TURBO_DEFAULT$",

        "src/**/*.ts",

        "tsconfig*.json",
        "tsup.config.*",

        "!dist/**",
        "!coverage/**",
        "!node_modules/**"
      ],

      "outputs": ["dist/**"]
    },

    "typecheck": {
      "dependsOn": ["^build"],

      "inputs": [
        "$TURBO_DEFAULT$",

        "src/**/*.ts",

        "tsconfig*.json",

        "!dist/**",
        "!coverage/**",
        "!node_modules/**"
      ],

      "outputs": []
    },

    "lint": {
      "dependsOn": ["^lint"],

      "inputs": [
        "$TURBO_DEFAULT$",

        "src/**/*.ts",

        "eslint.config.*",

        "!dist/**",
        "!coverage/**",
        "!node_modules/**"
      ],

      "outputs": []
    },

    "test": {
      "dependsOn": ["^build", "build"],

      "inputs": [
        "$TURBO_DEFAULT$",

        "src/**/*.ts",

        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.snap",

        "vitest.config.*",

        "!dist/**",
        "!coverage/**",
        "!node_modules/**"
      ],

      "outputs": ["coverage/**"]
    },

    "coverage": {
      "dependsOn": ["^build", "test"],

      "inputs": [
        "$TURBO_DEFAULT$",

        "src/**/*.ts",

        "**/*.test.ts",
        "**/*.spec.ts",

        "vitest.config.*",

        "!dist/**",
        "!coverage/**",
        "!node_modules/**"
      ],

      "outputs": ["coverage/**"]
    },

    "validate": {
      "dependsOn": ["^validate", "lint", "typecheck", "test"],

      "outputs": []
    }
  }
}
