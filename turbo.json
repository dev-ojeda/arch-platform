{
  "$schema": "https://turbo.build/schema.json",
  "noUpdateNotifier": true,
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "eslint.config.mjs",
    "config/eslint/**/*"
  ],

  "globalEnv": ["NODE_ENV", "CI", "GITHUB_ACTIONS"],

  "tasks": {
    "doctor": {
      "cache": false,
      "outputs": []
    },

    "clean": {
      "cache": false,
      "outputs": []
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "**/*.tsbuildinfo", ".tsbuildinfo"]
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["**/*.tsbuildinfo", ".tsbuildinfo"]
    },

    // 1. Tarea estándar para todos los paquetes individuales del monorrepo
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".eslintcache"]
    },

    // 2. OPTIMIZACIÓN CRUCIAL: Tarea de la raíz (Root Task) para auditar la carpeta global de scripts
    // El prefijo '://#' le indica a Turborepo que esta tarea pertenece al package.json raíz.
    "//#lint:scripts": {
      "cache": true,
      "inputs": ["scripts/**/*", "config/**/*", "eslint.config.mjs"],
      "outputs": [".eslintcache"]
    },

    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
