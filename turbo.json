{
  "$schema": "./node_modules/turbo/schema.json",
  "noUpdateNotifier": true,
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "eslint.config.mjs",
    "config/eslint/**/*"
  ],
  "globalEnv": ["NODE_ENV", "CI", "GITHUB_ACTIONS", "NODE_OPTIONS", "UV_THREADPOOL_SIZE"],
  "tasks": {
    "doctor": {
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "**/*.tsbuildinfo", ".tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".eslintcache"]
    },
    "//#lint:scripts": {
      "dependsOn": ["@arch-platform/cli#build"],
      "cache": true,
      "inputs": ["scripts/**/*", "config/**/*", "eslint.config.mjs"],
      "outputs": [".eslintcache"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "coverage": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    }
  }
}
